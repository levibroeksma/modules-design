---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  type?: string;
}

const { id, label, placeholder, type = "text" } = Astro.props;
---

<section class="mb-6">
  <label for={id} class="sr-only">{label}</label>
  <input id={id} type={type} class="surface input" placeholder={placeholder} />
</section>
