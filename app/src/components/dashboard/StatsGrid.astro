---
import StatCard from "../ui/StatCard.astro";

interface StatItem {
  label: string;
  value: string;
  hint?: string;
  hintAccent?: boolean;
}

interface Props {
  items: StatItem[];
}

const { items } = Astro.props;
---

<section class="mb-6 grid grid-cols-2 gap-3">
  {
    items.map((item) => (
      <StatCard
        label={item.label}
        value={item.value}
        hint={item.hint}
        hintAccent={item.hintAccent}
      />
    ))
  }
</section>
