---
import Input from "../../ui/Input.astro";
import Toggle from "../../ui/Toggle.astro";
import RoundSelect from "../RoundSelect.astro";

const formatOpts = [
  { value: "bestOf", label: "Best of" },
  { value: "firstTo", label: "First to" },
];

const roundTypeOpts = [
  { value: "legs", label: "Legs" },
  { value: "sets", label: "Sets" },
];

const modeOpts = [
  { value: "single", label: "Single player" },
  { value: "multi", label: "Multiplayer" },
];

const startingScoreOpts = [
  { value: "301", label: "301" },
  { value: "501", label: "501" },
  { value: "701", label: "701" },
];
---

<div class="flex flex-col gap-2 max-w-sm">
  <form
    x-data="gameConfig"
    class="flex flex-col gap-5"
    @prevent.submit="event.preventDefault()"
  >
    {/* Player mode configuration */}
    <fieldset>
      <Toggle
        orientation="horizontal"
        options={modeOpts}
        x-model="mode"
        class="w-full"
      />
    </fieldset>
    {/* Round configuration */}
    <fieldset class="flex gap-2">
      <Toggle
        orientation="vertical"
        options={formatOpts}
        x-model="format"
        class="w-3/7"
      />
      <RoundSelect class="w-1/7" />
      <Toggle
        orientation="vertical"
        options={roundTypeOpts}
        x-model="roundType"
        class="w-3/7"
      />
    </fieldset>
    {/* Starting score configuration */}
    <fieldset>
      <Toggle
        orientation="horizontal"
        options={startingScoreOpts}
        x-model="startingScore"
        class="w-full"
      />
    </fieldset>
  </form>
</div>
