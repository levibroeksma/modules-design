---
interface Props {
  title: string;
  message: string;
  confirmHref?: string;
}

const { title, message, confirmHref = "/" } = Astro.props as Props;
---

<div
  x-show="open"
  x-cloak
  class="fixed inset-0 z-50 flex items-center justify-center p-4"
  role="presentation"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-out duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  @keydown.escape.window="open = false"
>
  <div
    class="absolute inset-0 bg-bg/80 backdrop-blur-sm"
    aria-hidden="true"
    @click="open = false"
  >
  </div>

  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="confirm-modal-title"
    aria-describedby="confirm-modal-message"
    class="glass-strong relative w-full max-w-sm rounded-lg border border-border p-4 font-sans text-left normal-case shadow-lg"
  >
    <h2
      id="confirm-modal-title"
      class="font-mono text-lg font-bold tracking-normal text-fg"
    >
      {title}
    </h2>
    <p
      id="confirm-modal-message"
      class="mt-1.5 font-sans text-sm font-normal text-fg-muted"
    >
      {message}
    </p>

    <div class="mt-5 flex justify-end gap-2 font-sans">
      <button
        type="button"
        class="btn btn-ghost min-h-9 w-1/3 px-3 font-sans text-sm font-normal"
        @click="open = false"
      >
        Cancel
      </button>
      <a
        href={confirmHref}
        class="btn btn-primary min-h-9 w-1/3 px-3 font-sans text-sm font-normal"
      >
        Yes
      </a>
    </div>
  </div>
</div>
