---
interface Props {
  id?: string;
  title?: string;
  height?: number;
  class?: string;
}

const {
  id = "donut-chart",
  title = "Storage breakdown",
  height = 176,
  class: className = "",
} = Astro.props;
---

<div class:list={["surface p-4", className]}>
  <p class="mb-3 text-xs font-medium text-fg-subtle">{title}</p>
  <div class="chart-frame" style={`height: ${height}px`}>
    <canvas
      id={id}
      data-chart="donut"
      data-height={height}
      height={height}
      role="img"
      aria-label={title}></canvas>
  </div>
</div>
